{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run Chess Game",
      "request": "launch",
      "mainClass": "com.lanchess.app.Launcher",
      "classPaths": [
        "${workspaceFolder}/target/classes",
        "${workspaceFolder}/target/lib/*"
      ],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "preLaunchTask": "maven: build for launch"
    }
  ]
}
